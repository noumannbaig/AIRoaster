# ---------------------------------------------------------------------------
# RoastMe AI — environment variables
# Copy to .env.local for local development (never commit .env files).
# ---------------------------------------------------------------------------

# Postgres connection string. Local example:
#   postgresql://postgres:postgres@127.0.0.1:5432/roastme?schema=public
DATABASE_URL=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Any modern chat model with JSON + vision support.
OPENAI_MODEL=gpt-4o-mini

# Dev-only escape hatch. When "true" AND NODE_ENV !== "production", roasts are
# served from a local fixture generator instead of OpenAI so the full funnel can
# be exercised without an API key. Never enable this in production.
DEV_FAKE_AI=false

# --- Lemon Squeezy ----------------------------------------------------------
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID_FULL_ROAST=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Optional second product ($4.99). Leave blank for the MVP.
LEMON_SQUEEZY_VARIANT_ID_ULTIMATE_ROAST=
# Set to "true" to send Lemon Squeezy checkouts in test mode.
LEMON_SQUEEZY_TEST_MODE=true

# --- App --------------------------------------------------------------------
# No trailing slash. Used for checkout redirects, share links and OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:43127

# Protects /admin. Use a long random string.
ADMIN_SECRET=

# --- Analytics --------------------------------------------------------------
# "db" (default, stores events in Postgres), "posthog", or "none".
ANALYTICS_PROVIDER=db
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=https://us.i.posthog.com

# --- Storage ----------------------------------------------------------------
# "vercel-blob" (production default) or "local" (writes to ./public/uploads).
STORAGE_PROVIDER=local
STORAGE_BUCKET=roastme-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Required when STORAGE_PROVIDER=vercel-blob (auto-injected on Vercel).
BLOB_READ_WRITE_TOKEN=
# Uploaded screenshots are purged after this many hours.
UPLOAD_RETENTION_HOURS=24

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ROASTS_PER_DAY=3
RATE_LIMIT_CHECKOUTS_PER_HOUR=10
RATE_LIMIT_UPLOADS_PER_HOUR=20
